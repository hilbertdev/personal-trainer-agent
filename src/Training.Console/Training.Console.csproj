<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TrainingRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</TrainingRuntimeIdentifier>
    <TrainingRuntimeIdentifier Condition="'$(TrainingRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</TrainingRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Training.Application\Training.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrainingRuntimeModule Include="..\Training.Infrastructure\Training.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="PublishTrainingRuntimeModules" BeforeTargets="Build">
    <MSBuild
      Projects="@(TrainingRuntimeModule)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishDir=$(MSBuildProjectDirectory)/$(IntermediateOutputPath)training-runtime-modules/;UseAppHost=false" />
  </Target>

  <Target Name="CopyTrainingRuntimeModules" AfterTargets="Build">
    <ItemGroup>
      <TrainingRuntimeModuleOutput Include="$(IntermediateOutputPath)training-runtime-modules/**/*.*" />
      <TrainingRuntimeModuleNativeOutput Include="$(IntermediateOutputPath)training-runtime-modules/runtimes/$(TrainingRuntimeIdentifier)/native/*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(TrainingRuntimeModuleOutput)"
      DestinationFiles="@(TrainingRuntimeModuleOutput->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(TrainingRuntimeModuleNativeOutput)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyTrainingRuntimeModulesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <TrainingRuntimeModulePublishOutput Include="$(IntermediateOutputPath)training-runtime-modules/**/*.*" />
      <TrainingRuntimeModuleNativePublishOutput Include="$(IntermediateOutputPath)training-runtime-modules/runtimes/$(TrainingRuntimeIdentifier)/native/*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(TrainingRuntimeModulePublishOutput)"
      DestinationFiles="@(TrainingRuntimeModulePublishOutput->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(TrainingRuntimeModuleNativePublishOutput)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
