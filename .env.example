# API
ASPNETCORE_URLS=http://+:8080
TRAINING_SQLITE_CONNECTION_STRING=Data Source=App_Data/training.db
# Include http://localhost:8081 when testing the Expo mobile app in the browser (Metro web).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081

# SaaS API (src/backend — docker-compose.saas.yml)
DB_PASSWORD=ChangeMe123!
JWT_KEY=your-jwt-secret-here-min-32-chars
RESEND_API_KEY=re_xxx
AWS_REGION=eu-west-1

# Mobile (src/mobile)
EXPO_PUBLIC_API_URL=http://localhost:5075

# Frontend (local Vite dev — /api is proxied to localhost:8080 in vite.config.ts)
VITE_API_URL=
VITE_USE_MOCK_DATA=false

# Mock-only UI (no API required)
# VITE_USE_MOCK_DATA=true

# Docker Compose builds the frontend with VITE_API_URL empty and nginx proxying /api to the api service.
