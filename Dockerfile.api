FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY WorkoutPlanner.sln ./
COPY src/WorkoutPlanner.Domain/WorkoutPlanner.Domain.csproj src/WorkoutPlanner.Domain/
COPY src/WorkoutPlanner.Application/WorkoutPlanner.Application.csproj src/WorkoutPlanner.Application/
COPY src/WorkoutPlanner.Infrastructure/WorkoutPlanner.Infrastructure.csproj src/WorkoutPlanner.Infrastructure/
COPY src/WorkoutPlanner.Api/WorkoutPlanner.Api.csproj src/WorkoutPlanner.Api/
RUN dotnet restore src/WorkoutPlanner.Api/WorkoutPlanner.Api.csproj

COPY . .
RUN dotnet publish src/WorkoutPlanner.Api/WorkoutPlanner.Api.csproj \
    --configuration Release \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "WorkoutPlanner.Api.dll"]
