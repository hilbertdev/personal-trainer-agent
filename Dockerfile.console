FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY WorkoutPlanner.sln ./
COPY src/WorkoutPlanner.Domain/WorkoutPlanner.Domain.csproj src/WorkoutPlanner.Domain/
COPY src/WorkoutPlanner.Application/WorkoutPlanner.Application.csproj src/WorkoutPlanner.Application/
COPY src/WorkoutPlanner.Infrastructure/WorkoutPlanner.Infrastructure.csproj src/WorkoutPlanner.Infrastructure/
COPY src/WorkoutPlanner.Console/WorkoutPlanner.Console.csproj src/WorkoutPlanner.Console/
RUN dotnet restore src/WorkoutPlanner.Console/WorkoutPlanner.Console.csproj

COPY . .
RUN dotnet publish src/WorkoutPlanner.Console/WorkoutPlanner.Console.csproj \
    --configuration Release \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "WorkoutPlanner.Console.dll"]
