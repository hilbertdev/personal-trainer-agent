FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Training.sln ./
COPY src/Training.Domain/Training.Domain.csproj src/Training.Domain/
COPY src/Training.Application/Training.Application.csproj src/Training.Application/
COPY src/Training.Infrastructure/Training.Infrastructure.csproj src/Training.Infrastructure/
COPY src/Training.Console/Training.Console.csproj src/Training.Console/
RUN dotnet restore src/Training.Console/Training.Console.csproj

COPY . .
RUN dotnet publish src/Training.Console/Training.Console.csproj \
    --configuration Release \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Training.Console.dll"]
